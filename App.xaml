<Application x:Class="DeliverableOrganizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="WarningBrush" Color="#C77C00" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#D32F2F" />
        <SolidColorBrush x:Key="SubTextBrush" Color="#707070" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Application.Resources>
</Application>
